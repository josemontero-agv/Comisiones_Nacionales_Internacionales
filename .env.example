# Ejemplo sin secretos. Copie a .env (está en .gitignore) y complete en local.
# La aplicación lee Gold solo en Supabase. No usa SQLite.

# Cadena postgresql:// del proyecto. Solo en el servidor. sslmode=require.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Contraseña del rol postgres, solo para dbt/profiles.yml vía env_var.
# COMMISSION_DB_PASSWORD=

# Origen de la página local que la API acepta además de localhost:3000
# COMISIONES_WEB_ORIGIN=http://127.0.0.1:3000

# El .env de Odoo usa estos nombres. No son la URL de Postgres:
# ODOO_URL, ODOO_DB, ODOO_USER, ODOO_PASSWORD, SECRET_KEY.
